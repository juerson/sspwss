{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ssp-echwks-do",
	"main": "src/index.js",
	"compatibility_date": "2025-11-09",
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyDurableObject"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyDurableObject",
				"name": "MY_DURABLE_OBJECT"
			}
		]
	},
	"observability": {
		"enabled": false
	},
	"vars": {
		"PSK": "2kWBzSkmVVkvv7wst8la",
		"CF_FALLBACK_IPS": "152.32.181.246:44070" // 等价PROXYIP，会失效。
	}
}
